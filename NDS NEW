local ClearCompat = (function()
	local Adapter = {}

	local function vectorSize(value)
		if typeof(value) == "Vector2" then
			return UDim2.fromOffset(value.X, value.Y)
		end
		return value or UDim2.fromOffset(748, 480)
	end

	function Adapter.CreateWindow(options)
		options = options or {}
		local rawWindow = Clear:CreateWindow({
			Title = options.Title or "Clear",
			StartOpen = true,
			ToggleKey = options.ToggleKey or Enum.KeyCode.LeftAlt,
			GuiName = options.GuiName or "ClearNDSPartControl",
			Size = vectorSize(options.Size),
		})
		local window = {
			Raw = rawWindow,
			Connections = {},
			Destroyed = false,
		}

		function window:_Connect(signal, handler)
			local connection = signal:Connect(handler)
			table.insert(self.Connections, connection)
			return connection
		end

		function window:Notify(data)
			rawWindow:Notify({
				Title = tostring(data.Title or "Clear"),
				Content = tostring(data.Content or data.Description or ""),
				Duration = tonumber(data.Duration) or 4,
			})
		end

		function window:CreateTab(tabOptions)
			tabOptions = tabOptions or {}
			local icon = tabOptions.Icon
			local iconText = type(icon) == "string" and #icon <= 2 and icon or nil
			local rawTab = rawWindow:AddTab({
				Title = tabOptions.Name or tabOptions.Title or "Tab",
				Icon = icon,
				IconText = iconText,
			})
			local tab = { Raw = rawTab, Window = self }

			function tab:Select()
				rawWindow:SelectTab(rawTab)
			end

			function tab:CreateSection(sectionOptions)
				sectionOptions = sectionOptions or {}
				local rawSection = rawTab:AddSection({
					Title = sectionOptions.Title or sectionOptions.Name or "Section",
					Description = sectionOptions.Description or "",
					Locked = sectionOptions.Locked,
					Side = sectionOptions.Side,
				})
				local section = { Raw = rawSection, Window = self.Window }

				function section:AddToggle(controlOptions)
					controlOptions = controlOptions or {}
					return rawSection:AddToggle({
						Title = controlOptions.Name or controlOptions.Title or "Toggle",
						Badge = controlOptions.Tag or controlOptions.Badge,
						Default = controlOptions.Default == true,
						Callback = controlOptions.Callback,
					})
				end

				function section:AddSlider(controlOptions)
					controlOptions = controlOptions or {}
					return rawSection:AddSlider({
						Title = controlOptions.Name or controlOptions.Title or "Slider",
						Min = controlOptions.Min,
						Max = controlOptions.Max,
						Default = controlOptions.Default,
						Round = controlOptions.Round ~= false,
						Callback = controlOptions.Callback,
					})
				end

				function section:AddDropdown(controlOptions)
					controlOptions = controlOptions or {}
					return rawSection:AddDropdown({
						Title = controlOptions.Name or controlOptions.Title or "Dropdown",
						Options = controlOptions.Options or controlOptions.Values or {},
						Default = controlOptions.Default,
						Open = controlOptions.Open == true,
						Callback = controlOptions.Callback,
					})
				end

				function section:AddButton(controlOptions)
					controlOptions = controlOptions or {}
					return rawSection:AddButton({
						Title = controlOptions.Name or controlOptions.Title or "Button",
						Callback = controlOptions.Callback,
					})
				end

				function section:AddParagraph(controlOptions)
					controlOptions = controlOptions or {}
					return rawSection:AddLabel({
						Text = controlOptions.Content or controlOptions.Description or controlOptions.Text or "",
						Height = controlOptions.Height,
					})
				end

				function section:AddInput(controlOptions)
					controlOptions = controlOptions or {}
					local value = tostring(controlOptions.Default or "")
					local label = rawSection:AddLabel({
						Text = string.format("%s: %s", controlOptions.Name or "Status", value),
					})
					local control = { TextBox = { Text = value } }
					function control:Set(newValue, silent)
						value = tostring(newValue or "")
						self.TextBox.Text = value
						label:Set(string.format("%s: %s", controlOptions.Name or "Status", value))
						if not silent and controlOptions.Callback then
							controlOptions.Callback(value)
						end
					end
					function control:Get()
						return value
					end
					return control
				end

				return section
			end

			return tab
		end

		local rawDestroy = rawWindow.Destroy
		function window:Destroy()
			if self.Destroyed then
				return
			end
			self.Destroyed = true
			for _, connection in ipairs(self.Connections) do
				pcall(function()
					connection:Disconnect()
				end)
			end
			table.clear(self.Connections)
			rawDestroy(rawWindow)
		end

		return window
	end

	return Adapter
end)()

