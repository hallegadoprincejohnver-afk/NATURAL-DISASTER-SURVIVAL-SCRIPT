		function tab._refreshLayout()
			task.defer(function()
				if not page.Parent then return end
				local leftY = 0
				local rightY = 0
				for index, section in ipairs(tab._sections) do
					local side = section.Side
					if side ~= "Left" and side ~= "Right" then
						side = index % 2 == 0 and "Right" or "Left"
					end
					local y = side == "Right" and rightY or leftY
					section.Frame.Position = UDim2.fromOffset(side == "Right" and 251 or 0, y)
					local height = section.Frame.AbsoluteSize.Y
					if height <= 0 then height = section.Frame.Size.Y.Offset end
					if side == "Right" then
						rightY = y + height + 10
					else
						leftY = y + height + 10
					end
				end
				page.CanvasSize = UDim2.fromOffset(0, math.max(leftY, rightY, 3))
			end)
		end
		table.insert(self._tabs, tab)
		connect(self, button.MouseButton1Click, function()
			self:SelectTab(tab)
		end)
		connect(self, button.MouseEnter, function()
			if self._activeTab ~= tab then
				tween(label, 0.12, { TextColor3 = THEME.TextDim })
				setSidebarIconColor(tab, THEME.TextDim)
			end
		end)
		connect(self, button.MouseLeave, function()
			if self._activeTab ~= tab then
				tween(label, 0.12, { TextColor3 = THEME.TextMuted })
				setSidebarIconColor(tab, THEME.TextMuted)
			end
		end)

