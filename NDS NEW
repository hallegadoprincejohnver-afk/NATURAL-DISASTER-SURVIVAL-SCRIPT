			function section:AddSlider(sliderConfig)
				sliderConfig = sliderConfig or {}
				local minimum = sliderConfig.Min or 0
				local maximum = sliderConfig.Max or 100
				local value = math.clamp(sliderConfig.Default or minimum, minimum, maximum)
				local row = create("Frame", {
					BackgroundTransparency = 1,
					LayoutOrder = #self._controls + 1,
					Size = UDim2.new(1, 0, 0, 54),
					Parent = sectionFrame,
				})
				addDivider(row)
				local label = textLabel({
					Position = UDim2.fromOffset(10, 6),
					Size = UDim2.new(1, -20, 0, 18),
					Font = Enum.Font.GothamMedium,
					TextColor3 = THEME.Text,
					TextSize = 10,
					TextXAlignment = Enum.TextXAlignment.Left,
					Parent = row,
				})
				local bar = textButton({
					AnchorPoint = Vector2.new(0, 0.5),
					BackgroundColor3 = Color3.fromRGB(52, 53, 56),
					Position = UDim2.fromOffset(10, 36),
					Size = UDim2.new(1, -20, 0, 5),
					Text = "",
					Parent = row,
				})
				addCorner(bar, 8)
				local fill = create("Frame", {
					BackgroundColor3 = THEME.ToggleOn,
					BorderSizePixel = 0,
					Size = UDim2.fromScale((value - minimum) / math.max(1, maximum - minimum), 1),
					Parent = bar,
				})
				addCorner(fill, 8)
				local control = {}
				function control:Set(newValue, silent)
					newValue = math.clamp(newValue, minimum, maximum)
					if sliderConfig.Round ~= false then
						newValue = math.floor(newValue + 0.5)
					end
					value = newValue
					label.Text = string.format("%s   %s", sliderConfig.Title or "Slider", tostring(value))
					fill.Size = UDim2.fromScale((value - minimum) / math.max(1, maximum - minimum), 1)
					if not silent then
						callback(sliderConfig.Callback, value)
					end
				end
				function control:Get()
					return value
				end
				local sliding = false
				local function setFromInput(input)
					local alpha = math.clamp((input.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
					control:Set(minimum + (maximum - minimum) * alpha)
				end
				connect(self._window, bar.InputBegan, function(input)
					if
						input.UserInputType == Enum.UserInputType.MouseButton1
						or input.UserInputType == Enum.UserInputType.Touch
					then
						sliding = true
						setFromInput(input)
					end
				end)
				connect(self._window, UserInputService.InputChanged, function(input)
					if
						sliding
						and (
							input.UserInputType == Enum.UserInputType.MouseMovement
							or input.UserInputType == Enum.UserInputType.Touch
						)
					then
						setFromInput(input)
					end
				end)
				connect(self._window, UserInputService.InputEnded, function(input)
					if
						input.UserInputType == Enum.UserInputType.MouseButton1
						or input.UserInputType == Enum.UserInputType.Touch
					then
						sliding = false
					end
				end)
				control:Set(value, true)
				table.insert(self._controls, control)
				refreshSection()
				return control
			end

			function section:AddLabel(labelConfig)
				if type(labelConfig) == "string" then
					labelConfig = { Text = labelConfig }
				end
				labelConfig = labelConfig or {}
				local row = create("Frame", {
