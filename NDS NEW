local function flashHammerTarget(target, succeeded)
	if not target or not target.Parent then return end
	local highlight = Instance.new("Highlight")
	highlight.Name = "ClearHammerHit"
	highlight.Adornee = target
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.FillColor = succeeded and Color3.fromRGB(105, 205, 255) or Color3.fromRGB(255, 134, 134)
	highlight.FillTransparency = 0.55
	highlight.OutlineColor = Color3.fromRGB(245, 250, 255)
	highlight.OutlineTransparency = 0.05
	highlight.Parent = PlayerGui
	task.delay(0.45, function()
		if highlight.Parent then highlight:Destroy() end
	end)
end

local function unanchorWithBlueHammer(target, showNotification)
	local structure = workspace:FindFirstChild("Structure")
	if not target or not target:IsA("BasePart") then
		if showNotification then notify("Blue Hammer", "Aim at an anchored map part, then click.") end
		return 0, 0
	end
	if not structure or not target:IsDescendantOf(structure) then
		flashHammerTarget(target, false)
		if showNotification then notify("Blue Hammer", "That part is outside workspace.Structure.") end
		return 0, 0
	end

	local connected = { target }
	local ok, result = pcall(function()
		return target:GetConnectedParts(true)
	end)
	if ok and type(result) == "table" then
		connected = result
		table.insert(connected, target)
	end

	local seen = {}
	local changed = 0
	local considered = 0
	for _, part in ipairs(connected) do
		if considered >= BLUE_HAMMER_MAX_PARTS then break end
		if part:IsA("BasePart") and part:IsDescendantOf(structure) and not seen[part] then
			seen[part] = true
			considered = considered + 1
			if part.Anchored then
				local unanchored = pcall(function()
					part.Anchored = false
					part.AssemblyLinearVelocity = Vector3.zero
					part.AssemblyAngularVelocity = Vector3.zero
				end)
				if unanchored and not part.Anchored then
					changed = changed + 1
				end
			end
		end
	end

	flashHammerTarget(target, changed > 0)
	if showNotification then
		if changed > 0 then
			local suffix = #connected > BLUE_HAMMER_MAX_PARTS and " (safety limit reached)" or ""
			notify("Blue Hammer", string.format("Unanchored %d connected Structure part%s.%s", changed, changed == 1 and "" or "s", suffix))
		else
			notify("Blue Hammer", "This assembly is already unanchored or the server restored it.")
		end
	end
	return changed, considered
end

