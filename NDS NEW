	return nil
end

local function clearFlyPose()
	for motor, originalTransform in pairs(state.flyPoseMotors) do
		if motor.Parent then
			motor.Transform = originalTransform
		end
	end
	table.clear(state.flyPoseMotors)
	if state.flyAnimateScript and state.flyAnimateScript.Parent and state.flyAnimateWasDisabled ~= nil then
		state.flyAnimateScript.Disabled = state.flyAnimateWasDisabled
	end
	state.flyPoseCharacter = nil
	state.flyAnimateScript = nil
	state.flyAnimateWasDisabled = nil
	state.flyStartedAt = 0
end

local function beginFlyPose(character)
	clearFlyPose()
	state.flyPoseCharacter = character
	state.flyStartedAt = os.clock()
	local animate = character:FindFirstChild("Animate")
	if animate and animate:IsA("LocalScript") then
		state.flyAnimateScript = animate
		state.flyAnimateWasDisabled = animate.Disabled
		animate.Disabled = true
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local animator = humanoid and humanoid:FindFirstChildOfClass("Animator")
	if animator then
		for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
			pcall(function() track:Stop(0.18) end)
		end
	end
	for _, motor in ipairs(character:QueryDescendants("Motor6D, AnimationConstraint")) do
		state.flyPoseMotors[motor] = motor.Transform
	end
end

local function flyMotorOffset(motorName, elapsed)
	local compactName = string.lower(string.gsub(motorName, "%s+", ""))
	local breathe = math.sin(elapsed * 2.2)
	if string.find(compactName, "rightshoulder", 1, true) then
		return CFrame.Angles(math.rad(-18 + breathe * 3), math.rad(6), math.rad(32))
	end
	if string.find(compactName, "leftshoulder", 1, true) then
		return CFrame.Angles(math.rad(-18 + breathe * 3), math.rad(-6), math.rad(-32))
	end
	if string.find(compactName, "righthip", 1, true) then
		return CFrame.Angles(math.rad(-16 - breathe * 2), 0, math.rad(10))
	end
	if string.find(compactName, "lefthip", 1, true) then
		return CFrame.Angles(math.rad(-16 - breathe * 2), 0, math.rad(-10))
	end
	if compactName == "root" or compactName == "rootjoint" then
		return CFrame.new(0, math.sin(elapsed * 1.8) * 0.12, 0)
			* CFrame.Angles(math.rad(5 + breathe * 1.5), 0, math.rad(math.sin(elapsed * 1.3) * 2))
	end
	if compactName == "neck" then
		return CFrame.Angles(math.rad(-4 - breathe), 0, 0)
	end
	return CFrame.identity
end

local function updateFlyPose(character)
	if state.flyPoseCharacter ~= character then
		beginFlyPose(character)
	end
	local elapsed = os.clock() - state.flyStartedAt
	for motor, originalTransform in pairs(state.flyPoseMotors) do
		if motor.Parent then
			local target = originalTransform * flyMotorOffset(motor.Name, elapsed)
			motor.Transform = motor.Transform:Lerp(target, 0.16)
		end
	end
end

local function clearFlyMovers()
	if state.flyVelocity then
		state.flyVelocity:Destroy()
		state.flyVelocity = nil
	end
	if state.flyGyro then
