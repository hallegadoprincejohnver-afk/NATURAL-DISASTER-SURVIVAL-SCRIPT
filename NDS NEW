local function seatAssemblyRoot(seat)
	if not seat or not seat.Parent or seat.Anchored then
		return nil
	end
	local root = seat.AssemblyRootPart or seat
	if not root or not root:IsA("BasePart") or root.Anchored then
		return nil
	end
	return root
end

local function scanUnanchoredSeats()
	local seats = {}
	local owned = 0
	local ok, found = pcall(function()
		return workspace:QueryDescendants("Seat[Anchored = false], VehicleSeat[Anchored = false]")
	end)
	if ok then
		for _, seat in ipairs(found) do
			local root = seatAssemblyRoot(seat)
			if root then
				table.insert(seats, seat)
				if isOwned(root) then owned = owned + 1 end
			end
		end
	end
	state.unanchoredSeats = seats
	if not state.seatTeleportBusy then
		if #seats == 0 then
			updateSeatStatus("No unanchored Seat or VehicleSeat exists on this map yet.")
		else
			updateSeatStatus(string.format("Detected %d unanchored seats | %d client-owned", #seats, owned))
		end
	end
	return seats
end

