-- Crisp, dependency-free sidebar glyphs. These are drawn from Frames/UIStrokes
-- so the sidebar never falls back to single-letter placeholders or missing fonts.
local function makeSidebarIcon(parent, iconName, color)
	local holder = create("Frame", {
		Name = tostring(iconName or "Tab") .. "Icon",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(18, 18),
		Parent = parent,
	})
	local colorTargets = {}

	local function track(object, property)
		table.insert(colorTargets, { Object = object, Property = property })
		return object
	end

	local function line(x, y, width, height, rotation)
		local part = create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			BackgroundColor3 = color,
			BorderSizePixel = 0,
			Position = UDim2.fromOffset(x, y),
			Rotation = rotation or 0,
			Size = UDim2.fromOffset(width, height),
			Parent = holder,
		})
		addCorner(part, 100)
		return track(part, "BackgroundColor3")
	end

	local function outline(x, y, width, height, radius, thickness)
		local frame = create("Frame", {
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(x, y),
			Size = UDim2.fromOffset(width, height),
			Parent = holder,
		})
		addCorner(frame, radius or 2)
		local stroke = addStroke(frame, color, thickness or 1.35, 0.05)
		track(stroke, "Color")
		return frame
	end

	local key = string.lower(tostring(iconName or ""))
	if key == "parts" or key == "world" then
		-- Isometric cube.
		line(6, 4, 7, 1.4, -30)
		line(12, 4, 7, 1.4, 30)
		line(6, 7.5, 7, 1.4, 30)
		line(12, 7.5, 7, 1.4, -30)
		line(3, 10.5, 1.4, 7, 0)
		line(15, 10.5, 1.4, 7, 0)
		line(6, 14, 7, 1.4, 30)
		line(12, 14, 7, 1.4, -30)
		line(9, 12, 1.4, 7, 0)
	elseif key == "build" or key == "combat" then
		-- Hammer.
		line(10.5, 10.5, 2.4, 13, -38)
		line(6.2, 5.3, 9, 3, -38)
		line(3.8, 7, 3.5, 1.6, -38)
	elseif key == "player" or key == "avatar" then
		-- Head and shoulders.
		outline(6, 1.5, 6, 6, 100, 1.5)
		outline(3, 10, 12, 6.5, 7, 1.5)
		line(3.6, 15.5, 1.4, 3, 0)
		line(14.4, 15.5, 1.4, 3, 0)
	elseif key == "seats" or key == "seat" then
		-- Chair profile.
		line(5, 6.5, 2, 9, 0)
		line(9.5, 10, 11, 2, 0)
		line(6, 14, 2, 7, 0)
		line(13, 14, 2, 7, 0)
		line(14.5, 8, 2, 6, 0)
	elseif key == "settings" or key == "gui" or key == "misc" then
		-- Gear with a clean central hub.
		outline(5, 5, 8, 8, 100, 1.5)
		outline(7.3, 7.3, 3.4, 3.4, 100, 1.3)
		line(9, 2.5, 2, 4, 0)
		line(9, 15.5, 2, 4, 0)
		line(2.5, 9, 4, 2, 0)
		line(15.5, 9, 4, 2, 0)
		line(4.3, 4.3, 2, 3.6, -45)
		line(13.7, 13.7, 2, 3.6, -45)
		line(13.7, 4.3, 2, 3.6, 45)
		line(4.3, 13.7, 2, 3.6, 45)
	else
		-- Neutral target icon for custom tabs.
		outline(3, 3, 12, 12, 100, 1.5)
		outline(7, 7, 4, 4, 100, 1.3)
	end

	return holder, colorTargets
end

local function setSidebarIconColor(tab, color)
	for _, target in ipairs(tab._iconColorTargets or {}) do
		if target.Object and target.Object.Parent then
			local properties = {}
			properties[target.Property] = color
			tween(target.Object, 0.14, properties)
		end
	end
end

local function makeDraggable(window, handle, target, onDragged)
	local dragging = false
	local dragType
	local dragStart
	local startPosition
	local function stopDragging()
		dragging = false
		dragType = nil
	end

	connect(window, handle.InputBegan, function(input)
		if
			input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch
		then
			dragging = true
			dragType = input.UserInputType
			dragStart = input.Position
			startPosition = target.Position
		end
	end)

	connect(window, UserInputService.InputChanged, function(input)
		if not dragging then
			return
		end
		if not handle.Visible then
			stopDragging()
			return
		end
		if dragType == Enum.UserInputType.MouseButton1
			and not UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
		then
			stopDragging()
			return
		end
		local isMouseDrag = dragType == Enum.UserInputType.MouseButton1
			and input.UserInputType == Enum.UserInputType.MouseMovement
		local isTouchDrag = dragType == Enum.UserInputType.Touch
			and input.UserInputType == Enum.UserInputType.Touch
		if not isMouseDrag and not isTouchDrag then
			return
		end
		local delta = input.Position - dragStart
		if onDragged and (math.abs(delta.X) > 4 or math.abs(delta.Y) > 4) then
			onDragged()
		end

		local viewport = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize
		if not viewport then
			return
		end
		local size = target.AbsoluteSize
		local anchor = target.AnchorPoint
		local pointX = startPosition.X.Scale * viewport.X + startPosition.X.Offset + delta.X
		local pointY = startPosition.Y.Scale * viewport.Y + startPosition.Y.Offset + delta.Y
		local minX = 8 + size.X * anchor.X
		local maxX = viewport.X - 8 - size.X * (1 - anchor.X)
		local minY = 8 + size.Y * anchor.Y
		local maxY = viewport.Y - 8 - size.Y * (1 - anchor.Y)
		pointX = math.clamp(pointX, minX, math.max(minX, maxX))
		pointY = math.clamp(pointY, minY, math.max(minY, maxY))
		target.Position = UDim2.new(
			startPosition.X.Scale,
			pointX - startPosition.X.Scale * viewport.X,
			startPosition.Y.Scale,
			pointY - startPosition.Y.Scale * viewport.Y
		)
	end)

	connect(window, UserInputService.InputEnded, function(input)
		if dragging and input.UserInputType == dragType then
			stopDragging()
		end
	end)
	connect(window, UserInputService.WindowFocusReleased, stopDragging)
end

local function resolveParent(customParent)
	if customParent then
		return customParent
	end
	local player = Players.LocalPlayer
	if not player then
		return game:GetService("CoreGui")
	end
	return player:WaitForChild("PlayerGui")
end

local function updatePageCanvas(tab)
	if tab and tab._refreshLayout then
		tab._refreshLayout()
	end
end

