					search.Visible = open
					list.Visible = open
					tween(row, 0.18, { Size = UDim2.new(1, 0, 0, open and 254 or 66) })
					tween(box, 0.18, { Size = UDim2.new(1, -27, 0, open and 213 or 25) })
					task.delay(0.2, refreshSection)
				end
				function control:Refresh(newOptions, keepSelection)
					optionsList = newOptions or {}
					if not keepSelection then
						selected = optionsList[1] or "None"
						selectedLabel.Text = tostring(selected)
					end
					populate(search.Text)
				end

