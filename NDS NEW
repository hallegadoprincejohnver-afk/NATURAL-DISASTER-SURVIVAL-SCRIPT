					TextWrapped = true,
					TextXAlignment = Enum.TextXAlignment.Left,
					Parent = row,
				})
				local control = {}
				function control:Set(text)
					label.Text = tostring(text)
				end
				table.insert(self._controls, control)
				refreshSection()
				return control
			end

			section.Frame = sectionFrame
			table.insert(self._sections, section)
			refreshSection()
