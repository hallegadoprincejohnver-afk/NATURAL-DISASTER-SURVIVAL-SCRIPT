	function window:SetVisible(visible)
		self._visible = not not visible
		if self._visible then
			launcher.Visible = false
			main.Visible = true
			main.BackgroundTransparency = 1
			tween(main, 0.18, { BackgroundTransparency = 0 })
		else
			searchBox.Visible = false
			searchBox.Text = ""
			main.Visible = false
			launcher.Visible = true
		end
	end

	function window:Toggle()
		self:SetVisible(not self._visible)
	end

	function window:SetToggleKey(keyCode)
		if typeof(keyCode) == "EnumItem" and keyCode.EnumType == Enum.KeyCode then
			self._toggleKey = keyCode
		end
	end

	function window:GetToggleKey()
		return self._toggleKey
	end

	function window:SetKeyCapture(active)
		self._capturingKey = not not active
	end

	function window:SelectTab(tabOrName)
		local chosen
		for _, tab in ipairs(self._tabs) do
			if tab == tabOrName or tab.Title == tabOrName then
				chosen = tab
				break
			end
		end
		if not chosen then
			return
		end
		self._activeTab = chosen
		for _, tab in ipairs(self._tabs) do
			local active = tab == chosen
			tab._page.Visible = active
			tween(tab._label, 0.14, { TextColor3 = active and THEME.White or THEME.TextMuted })
			setSidebarIconColor(tab, active and THEME.White or THEME.TextMuted)
			tab._activeBar.Visible = active
		end
	end

