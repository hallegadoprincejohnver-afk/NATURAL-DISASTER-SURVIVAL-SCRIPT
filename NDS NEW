		and weld.Part1 ~= nil
		and weld.Part1:IsDescendantOf(humanoid.Parent)
end

local function touchSeatToPlayer(seat, character, targetRoot)
	local touchFunction = getgenv().firetouchinterest or firetouchinterest
	if type(touchFunction) ~= "function" then return end
	local seen = {}
	local candidates = {
		targetRoot,
		character:FindFirstChild("LowerTorso"),
		character:FindFirstChild("Torso"),
		character:FindFirstChild("LeftUpperLeg"),
		character:FindFirstChild("RightUpperLeg"),
		character:FindFirstChild("LeftLowerLeg"),
		character:FindFirstChild("RightLowerLeg"),
		character:FindFirstChild("LeftFoot"),
		character:FindFirstChild("RightFoot"),
		character:FindFirstChild("Left Leg"),
		character:FindFirstChild("Right Leg"),
	}
	for _, touchPart in ipairs(candidates) do
		if touchPart and touchPart:IsA("BasePart") and not seen[touchPart] then
			seen[touchPart] = true
			pcall(touchFunction, seat, touchPart, 0)
			pcall(touchFunction, seat, touchPart, 1)
		end
	end
end

local function seatAssemblyPartCount(root)
	local count = 1
	pcall(function()
		count = #root:GetConnectedParts(true) + 1
	end)
	return count
end

local function setSeatPosition(seat, root, desiredSeatCFrame, seatToRoot, velocity)
	if not seat.Parent or not root.Parent then return false end
	root.CFrame = desiredSeatCFrame * seatToRoot
	root.AssemblyLinearVelocity = velocity or Vector3.new(0, 0.1, 0)
	root.AssemblyAngularVelocity = Vector3.zero
	return true
end

local function chooseSeatCandidate(player, humanoid, targetRoot)
	local currentSeat = humanoid.SeatPart
	if currentSeat and not currentSeat.Anchored
		and (currentSeat:IsA("Seat") or currentSeat:IsA("VehicleSeat")) then
		local currentRoot = seatAssemblyRoot(currentSeat)
		if currentRoot then
			return currentSeat, currentRoot
		end
	end

	local ownedSeat
	local ownedRoot
	local ownedScore = math.huge
	local fallbackSeat
	local fallbackRoot
	local fallbackScore = math.huge
	local localRoot = getRootPart(LocalPlayer)
	for _, seat in ipairs(scanUnanchoredSeats()) do
		local root = seatAssemblyRoot(seat)
		if root and (seat.Occupant == nil or seat.Occupant == humanoid) then
			if isOwned(root) then
				local distance = (seat.Position - targetRoot.Position).Magnitude
				local score = seatAssemblyPartCount(root) * 1000 + distance
				if score < ownedScore then
					ownedSeat = seat
					ownedRoot = root
					ownedScore = score
				end
			else
				local origin = localRoot and localRoot.Position or targetRoot.Position
				local distance = (seat.Position - origin).Magnitude
				local score = seatAssemblyPartCount(root) * 1000 + distance
				if score < fallbackScore then
					fallbackSeat = seat
					fallbackRoot = root
					fallbackScore = score
				end
			end
		end
	end
	return ownedSeat or fallbackSeat, ownedRoot or fallbackRoot
end

local function tryClaimSeatOwnership(seat, root)
	if isOwned(root) then return true end
	local character = LocalPlayer.Character
	local localRoot = getRootPart(LocalPlayer)
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not localRoot or not humanoid or humanoid.Health <= 0 or seat.Occupant ~= nil then
		return false
	end

	local returnCFrame = localRoot.CFrame
	local returnLinearVelocity = localRoot.AssemblyLinearVelocity
	local returnAngularVelocity = localRoot.AssemblyAngularVelocity
	local returnPlatformStand = humanoid.PlatformStand
	local deadline = os.clock() + 1.6
	updateSeatStatus("Acquiring the loose seat; briefly moving near its assembly...")

	while state.seatDetectionEnabled and state.seatTeleportBusy
		and seat.Parent and root.Parent and not root.Anchored
		and humanoid.Parent and humanoid.Health > 0 and seat.Occupant == nil
		and os.clock() < deadline and not isOwned(root) do
		expandSeatSimulationRadius()
		localRoot.CFrame = CFrame.new(seat.Position + Vector3.new(0, math.max(12, seat.Size.Y + 8), 0))
		localRoot.AssemblyLinearVelocity = Vector3.zero
		localRoot.AssemblyAngularVelocity = Vector3.zero
		humanoid.PlatformStand = true
		RunService.Heartbeat:Wait()
	end

	if localRoot.Parent then
		localRoot.CFrame = returnCFrame
		localRoot.AssemblyLinearVelocity = returnLinearVelocity
		localRoot.AssemblyAngularVelocity = returnAngularVelocity
	end
	if humanoid.Parent then humanoid.PlatformStand = returnPlatformStand end
	return root.Parent ~= nil and isOwned(root)
end

local function teleportSelectedPlayerWithSeat()
	if state.seatTeleportBusy then
		notify("Seat Teleport", "The seat is already following the selected player.")
		return
	end
	local player = selectedSeatPlayer()
	if not player or player == LocalPlayer then
		notify("Seat Teleport", "Choose another player from the dropdown first.")
		return
	end

	state.seatDetectionEnabled = true
	state.seatTeleportBusy = true
	state.seatScanAccumulator = 0
	if SeatDetectorToggle then SeatDetectorToggle:Set(true, true) end
	task.spawn(function()
		local success = false
		local ok, failure = xpcall(function()
			expandSeatSimulationRadius()
			while state.seatDetectionEnabled and state.seatTeleportBusy and player.Parent and not success do
				local character = player.Character
				local humanoid = character and character:FindFirstChildOfClass("Humanoid")
				local targetRoot = getRootPart(player)
				if not humanoid or not targetRoot then
					updateSeatStatus("Waiting for " .. player.DisplayName .. " to respawn...")
					task.wait(0.35)
					continue
				end

				local seat, root = chooseSeatCandidate(player, humanoid, targetRoot)
				if not seat or not root then
					updateSeatStatus("This map has no free unanchored seats. Waiting for one to appear...")
					task.wait(0.35)
					continue
				end
				if not isOwned(root) and not tryClaimSeatOwnership(seat, root) then
					updateSeatStatus("Roblox kept this seat server-owned. Retrying the next available seat...")
					task.wait(0.35)
					continue
				end
				targetRoot = getRootPart(player)
				if not targetRoot then continue end

				local seatToRoot = seat.CFrame:ToObjectSpace(root.CFrame)
				local occupantConnection
				local seatWeldConnection
				local assemblyCollision = {}
				local function restoreSeatAssemblyCollision()
					for part, properties in pairs(assemblyCollision) do
						if part.Parent then
							pcall(function()
								part.CanCollide = properties.CanCollide
								part.CanTouch = properties.CanTouch
							end)
						end
					end
					table.clear(assemblyCollision)
				end
				local function disconnectOccupantConnection()
					if occupantConnection then
						occupantConnection:Disconnect()
						occupantConnection = nil
					end
					if seatWeldConnection then
						seatWeldConnection:Disconnect()
						seatWeldConnection = nil
					end
				end
				local function snapOccupiedSeatToLocalPlayer()
					if not seatHasPlayer(seat, humanoid) then return false end
					local localRoot = getRootPart(LocalPlayer)
					if not localRoot or not seat.Parent or not root.Parent then return false end
					local destination = localRoot.CFrame * CFrame.new(0, -2.65, -6)
					return setSeatPosition(seat, root, destination, seatToRoot,
						localRoot.AssemblyLinearVelocity + Vector3.new(0, 0.1, 0))
				end
				occupantConnection = seat:GetPropertyChangedSignal("Occupant"):Connect(function()
					-- Seat network ownership can transfer as soon as another player sits.
					-- Move it in the same property-change frame while our client still has a chance.
					if state.seatDetectionEnabled and state.seatTeleportBusy then
						snapOccupiedSeatToLocalPlayer()
					end
				end)
				seatWeldConnection = seat.ChildAdded:Connect(function(child)
					if child.Name == "SeatWeld" and state.seatDetectionEnabled and state.seatTeleportBusy then
						snapOccupiedSeatToLocalPlayer()
					end
				end)
				pcall(function()
					local connectedParts = root:GetConnectedParts(true)
					table.insert(connectedParts, root)
					for _, part in ipairs(connectedParts) do
						if part ~= seat then
							assemblyCollision[part] = {
								CanCollide = part.CanCollide,
								CanTouch = part.CanTouch,
							}
							part.CanCollide = false
							part.CanTouch = false
						end
					end
					seat.Disabled = false
					seat.CanTouch = true
					seat.CanCollide = true
				end)
				local sweepStarted = os.clock()
				local lastTouchAttempt = -math.huge
				while state.seatDetectionEnabled and state.seatTeleportBusy
					and seat.Parent and root.Parent and not root.Anchored
					and humanoid.Parent and humanoid.Health > 0
					and not seatHasPlayer(seat, humanoid) do
					targetRoot = getRootPart(player)
					if not targetRoot or not isOwned(root) then break end
					local elapsed = os.clock() - sweepStarted
					local look = Vector3.new(targetRoot.CFrame.LookVector.X, 0, targetRoot.CFrame.LookVector.Z)
					if look.Magnitude < 0.01 then look = Vector3.new(0, 0, -1) else look = look.Unit end
					local basis = CFrame.lookAt(targetRoot.Position, targetRoot.Position + look)
					local desiredSeat
					if elapsed < 0.65 then
						-- A short visible approach only. Never spin while asking Roblox to seat.
						local alpha = math.clamp(elapsed / 0.65, 0, 1)
						local orbitRadius = (1 - alpha) * 3
						local orbitAngle = elapsed * math.rad(420)
						local spinAngle = elapsed * math.rad(540)
						desiredSeat = basis
							* CFrame.new(math.cos(orbitAngle) * orbitRadius, -2.8, math.sin(orbitAngle) * orbitRadius)
							* CFrame.Angles(0, spinAngle, 0)
						updateSeatStatus("Seat is approaching " .. player.DisplayName .. "...")
					else
						-- Live NDS seats with real SeatWelds sit about 1.7 studs below HRP.
						-- Sweep upward once, then hold perfectly still relative to the target.
						local seatElapsed = elapsed - 0.65
						local height = -2.8 + math.clamp(seatElapsed / 0.55, 0, 1) * 1.1
						desiredSeat = basis * CFrame.new(0, height, 0)
						if os.clock() - lastTouchAttempt >= 0.08 then
							lastTouchAttempt = os.clock()
							pcall(function()
								seat:Sit(humanoid)
								humanoid.Sit = true
							end)
							touchSeatToPlayer(seat, character, targetRoot)
						end
						updateSeatStatus("Seat is locked under " .. player.DisplayName .. " and waiting for SeatWeld...")
					end
					setSeatPosition(seat, root, desiredSeat, seatToRoot,
						targetRoot.AssemblyLinearVelocity)
					if seatHasPlayer(seat, humanoid) then
						-- Do not yield a physics frame before the first occupied-seat move.
						snapOccupiedSeatToLocalPlayer()
						break
					end
					RunService.Heartbeat:Wait()
				end

				if seatHasPlayer(seat, humanoid) then
					updateSeatStatus(player.DisplayName .. " is seated. Bringing the occupied seat to you...")
					snapOccupiedSeatToLocalPlayer()
					while state.seatDetectionEnabled and state.seatTeleportBusy
						and seat.Parent and root.Parent and seatHasPlayer(seat, humanoid) do
						local localRoot = getRootPart(LocalPlayer)
						targetRoot = getRootPart(player)
						if not localRoot then
							updateSeatStatus("Waiting for your character to respawn...")
							task.wait(0.2)
						elseif targetRoot and (targetRoot.Position - localRoot.Position).Magnitude <= 24 then
							success = true
							break
						else
							snapOccupiedSeatToLocalPlayer()
							RunService.Heartbeat:Wait()
						end
					end
				end
				disconnectOccupantConnection()
				restoreSeatAssemblyCollision()
			end
		end, debug.traceback)

		state.seatTeleportBusy = false
		if success then
			updateSeatStatus("Teleported " .. player.DisplayName .. " to you while seated.")
			notify("Seat Teleport", player.DisplayName .. " was brought to you.")
		elseif not state.seatDetectionEnabled then
			updateSeatStatus("Seat teleport cancelled by the toggle.")
		elseif not ok then
			local message = tostring(failure):match("^[^\n]+") or tostring(failure)
			updateSeatStatus("Seat teleport stopped: " .. message)
			notify("Seat Teleport", message)
		else
			updateSeatStatus("Selected player left the server.")
		end
	end)
end

local function disableAssemblyCollision(root)
	local ok, connected = pcall(root.GetConnectedParts, root, true)
	if not ok then
		connected = { root }
	end
	for _, part in ipairs(connected) do
		if part:IsA("BasePart") and state.partCanCollide[part] == nil then
			state.partCanCollide[part] = part.CanCollide
			part.CanCollide = false
		end
	end
end

local function restorePartCollision()
	for part, canCollide in pairs(state.partCanCollide) do
		if part.Parent then
			part.CanCollide = canCollide
		end
	end
	table.clear(state.partCanCollide)
end

local function setLayoutCollision(root, enabled)
	local ok, connected = pcall(root.GetConnectedParts, root, true)
	if not ok then
		connected = { root }
	end
	for _, part in ipairs(connected) do
		if part:IsA("BasePart") then
			if state.layoutCanCollide[part] == nil then
				state.layoutCanCollide[part] = part.CanCollide
			end
			-- Complex vehicles and buildings can violently self-collide when packed
			-- into a moving lift. Keep only each assembly root locally solid for
			-- Elevator/yard assemblies may contain complex buildings and vehicles.
			-- Keeping only their roots locally solid prevents packed debris from
			-- self-colliding and launching riders while the deck is moving.
			part.CanCollide = enabled and ((state.layoutKind ~= "elevator" and state.layoutKind ~= "yard") or part == root)
			if state.layoutKind == "platform" or state.layoutKind == "yard" then
				if state.layoutAppearance[part] == nil then
					state.layoutAppearance[part] = {
						Material = part.Material,
						Color = part.Color,
					}
				end
				if state.layoutKind == "yard" then
					local isFence = state.yardFenceRoots[root] == true
					part.Material = isFence and Enum.Material.WoodPlanks or Enum.Material.Grass
					part.Color = isFence and Color3.fromRGB(116, 78, 48) or Color3.fromRGB(82, 142, 70)
				else
					part.Material = Enum.Material.Concrete
					part.Color = Color3.fromRGB(135, 135, 140)
				end
			end
		end
	end
end

local function restoreLayoutCollision()
	for part, canCollide in pairs(state.layoutCanCollide) do
		if part.Parent then
			part.CanCollide = canCollide
		end
	end
	table.clear(state.layoutCanCollide)
	for part, appearance in pairs(state.layoutAppearance) do
		if part.Parent then
			part.Material = appearance.Material
			part.Color = appearance.Color
		end
	end
	table.clear(state.layoutAppearance)
end

local function restoreAntiFlingCollision()
	for part, canCollide in pairs(state.antiFlingCanCollide) do
		if part.Parent then
			part.CanCollide = canCollide
		end
	end
	table.clear(state.antiFlingCanCollide)
end

local function applyAntiFling(now)
	local character = LocalPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not humanoid or humanoid.Health <= 0 or not root then
		state.safeCFrame = nil
		return
	end

	local linearSpeed = root.AssemblyLinearVelocity.Magnitude
	local angularSpeed = root.AssemblyAngularVelocity.Magnitude
	if state.flyEnabled then
		state.safeCFrame = root.CFrame
		state.lastSafeUpdate = now
	elseif linearSpeed < 45 and angularSpeed < 25 and now - state.lastSafeUpdate >= 0.15 then
		state.safeCFrame = root.CFrame
		state.lastSafeUpdate = now
	elseif linearSpeed > 95 or angularSpeed > 55 then
		for _, part in ipairs(character:QueryDescendants("BasePart")) do
			part.AssemblyLinearVelocity = Vector3.zero
			part.AssemblyAngularVelocity = Vector3.zero
		end
		if state.safeCFrame then
			root.CFrame = state.safeCFrame
		end
	end

	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer and player.Character then
			for _, part in ipairs(player.Character:QueryDescendants("BasePart")) do
				if state.antiFlingCanCollide[part] == nil then
					state.antiFlingCanCollide[part] = part.CanCollide
				end
				part.CanCollide = false
			end
		end
	end
end

local function driveRoot(root, desiredCFrame)
	disableAssemblyCollision(root)
	root.CFrame = desiredCFrame
	-- A small continuous velocity keeps client-owned physics replication awake.
	root.AssemblyLinearVelocity = Vector3.new(0, 0.1, 0)
	root.AssemblyAngularVelocity = Vector3.zero
end

local function placementOffset(index)
	local zeroIndex = index - 1
	local angle = zeroIndex * 2.399963229728653
	local radius = math.min(12, math.sqrt(zeroIndex) * 1.5)
	local height = state.verticalOffset + (zeroIndex % 4) * 1.5
	return CFrame.new(math.cos(angle) * radius, height, math.sin(angle) * radius)
end

local function updateStatus(partCount, rootCount)
	local mode
	if state.placingMode then
		mode = string.upper(state.placingMode) .. " PREVIEW"
	elseif state.layoutActive then
		if state.layoutKind == "elevator" then
			local targetY = state.elevatorRaised and state.elevatorHeight or 0
			if math.abs(state.elevatorCurrentY - targetY) <= 0.1 then
				mode = state.elevatorRaised and "ELEVATOR TOP" or "ELEVATOR BOTTOM"
			else
				mode = state.elevatorRaised and "ELEVATOR RISING" or "ELEVATOR LOWERING"
			end
		elseif state.layoutKind == "yard" then
			mode = (state.yardDriveEnabled or state.yardRise or state.yardLower or state.yardVelocity.Magnitude > 0.1)
				and "YARD MOVING" or "YARD HOLD"
		else
			mode = string.upper(state.layoutKind or "BUILD")
		end
	elseif state.meteorActive then
		if state.meteorImpactTorso then
			mode = "METEOR IMPACT"
		elseif state.meteorThrown then
			mode = "METEOR THROWN"
		else
			mode = "SUMMONING METEOR"
		end
	elseif state.bringing then
		local remaining = math.max(0, math.ceil(state.bringDelay - (os.clock() - state.bringStartTime)))
		mode = remaining > 0 and ("COLLECTING " .. remaining .. "s") or "TORSO SPIN"
	elseif state.orbiting then
		mode = "ORBITING"
	elseif state.freezing then
		mode = "FROZEN"
	else
		mode = "STOPPED"
	end
	PartStatus:Set(string.format(
		"%s | %d parts | %d movable | %d moved | %d waiting | %d welded",
		mode,
		partCount or 0,
		rootCount or #state.roots,
		state.moved,
		state.unowned,
		state.welded
	), true)
end

local function stopBringing(showNotification)
	state.bringing = false
	state.bringStartTime = 0
	state.bringSpinAngle = 0
	for _, root in ipairs(state.roots) do
		if root.Parent and isOwned(root) then
			pcall(zeroMotion, root)
		end
	end
	restorePartCollision()
	state.moved = 0
	state.unowned = 0
	if not state.freezing then
		restoreSimulationRadius()
	end
	if showNotification then
		notify("Part Control", "Bringing stopped; parts were released in place.")
	end
end

local function stopOrbiting(showNotification)
	state.orbiting = false
	for _, root in ipairs(state.roots) do
		if root.Parent and isOwned(root) then
			pcall(zeroMotion, root)
		end
	end
	restorePartCollision()
	state.moved = 0
	state.unowned = 0
	if not state.bringing and not state.freezing then
		restoreSimulationRadius()
	end
	if showNotification then
		notify("Circle Parts", "Orbit stopped and controlled parts were released.")
	end
end

local function destroyPreview()
	if state.previewFolder then
		state.previewFolder:Destroy()
		state.previewFolder = nil
	end
	if Mouse.TargetFilter and Mouse.TargetFilter.Name == "__ZenthraNDSPlacementPreview" then
		Mouse.TargetFilter = state.previousMouseTargetFilter
	end
	state.previousMouseTargetFilter = nil
end

local function createGhostPart(parent, size, cframe)
	local part = Instance.new("Part")
	part.Name = "PlacementGhost"
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.CastShadow = false
	part.Material = Enum.Material.Neon
	part.Color = Color3.fromRGB(99, 220, 255)
	part.Transparency = 0.62
	part.Size = size
	part.CFrame = cframe
	part.Parent = parent
	return part
end

local function renderPlacementPreview()
	destroyPreview()
	if not state.placingMode or not state.placementCFrame then
		return
	end

	local folder = Instance.new("Folder")
	folder.Name = "__ZenthraNDSPlacementPreview"
	folder.Parent = workspace
	state.previewFolder = folder
	state.previousMouseTargetFilter = Mouse.TargetFilter
	Mouse.TargetFilter = folder

	if state.placingMode == "stairs" then
		for step = 0, 31 do
			local desired = state.placementCFrame * CFrame.new(0, step * 6, -step * 5)
			createGhostPart(folder, Vector3.new(16, 1, 5), desired)
		end
	elseif state.placingMode == "elevator" then
		createGhostPart(folder, Vector3.new(50, 1, 50), state.placementCFrame)
	elseif state.placingMode == "yard" then
		local tileIndex = 0
		for row = -2, 2 do
			for column = -2, 2 do
				tileIndex = tileIndex + 1
				local offset = CFrame.new(column * 12, 0, row * 12)
				local ghost = createGhostPart(folder, Vector3.new(11.6, 1, 11.6), state.placementCFrame * offset)
				ghost.Name = "YardTileGhost" .. tileIndex
				ghost:SetAttribute("YardOffset", offset)
			end
		end
		local fences = {
			{ Vector3.new(60, 4, 2), CFrame.new(0, 2.5, -30) },
			{ Vector3.new(60, 4, 2), CFrame.new(0, 2.5, 30) },
			{ Vector3.new(2, 4, 60), CFrame.new(-30, 2.5, 0) },
			{ Vector3.new(2, 4, 60), CFrame.new(30, 2.5, 0) },
		}
		for index, definition in ipairs(fences) do
			local ghost = createGhostPart(folder, definition[1], state.placementCFrame * definition[2])
			ghost.Name = "YardFenceGhost" .. index
			ghost.Color = Color3.fromRGB(226, 184, 115)
			ghost:SetAttribute("YardOffset", definition[2])
		end
	else
		createGhostPart(folder, Vector3.new(100, 1, 100), state.placementCFrame)
	end
end

local function updatePlacementFromMouse()
	if not state.placingMode or not state.placementCFrame then
		return
	end
	local localRoot = getRootPart(LocalPlayer)
	if not localRoot then
		return
	end
	local hitPosition = Mouse.Hit.Position
	local flatOffset = Vector3.new(hitPosition.X - localRoot.Position.X, 0, hitPosition.Z - localRoot.Position.Z)
	if flatOffset.Magnitude > 450 then
		flatOffset = flatOffset.Unit * 450
	end
	local position = Vector3.new(
		localRoot.Position.X + flatOffset.X,
		state.placementGroundY + state.placementHeight,
		localRoot.Position.Z + flatOffset.Z
	)
	local forward = state.placementCFrame.LookVector
	state.placementCFrame = CFrame.lookAt(position, position + Vector3.new(forward.X, 0, forward.Z))
	if state.previewFolder then
		if state.placingMode == "stairs" then
			local step = 0
			for _, ghost in ipairs(state.previewFolder:GetChildren()) do
				ghost.CFrame = state.placementCFrame * CFrame.new(0, step * 6, -step * 5)
				step = step + 1
			end
		elseif state.placingMode == "yard" then
			for _, ghost in ipairs(state.previewFolder:GetChildren()) do
				local offset = ghost:GetAttribute("YardOffset")
				if offset then ghost.CFrame = state.placementCFrame * offset end
			end
		else
			local ghost = state.previewFolder:FindFirstChild("PlacementGhost")
			if ghost then
				ghost.CFrame = state.placementCFrame
			end
		end
	end
end

stopPlacement = function(showNotification)
	local wasPlacing = state.placingMode ~= nil
	state.placingMode = nil
	state.placementDragging = false
	destroyPreview()
	if showNotification and wasPlacing then
		notify("Placement", "Preview cancelled; no map assemblies were moved.")
	end
end

