				local setSelected
				local function populate(filter)
					filter = string.lower(filter or "")
					for _, optionButton in ipairs(optionButtons) do
						optionButton:Destroy()
					end
					table.clear(optionButtons)
					local visibleCount = 0
					for index, option in ipairs(optionsList) do
						local optionText = tostring(option)
						if filter == "" or string.find(string.lower(optionText), filter, 1, true) then
							visibleCount += 1
							local optionButton = textButton({
								BackgroundColor3 = THEME.Field,
								LayoutOrder = index,
								Size = UDim2.new(1, -4, 0, 16),
								Text = optionText,
								TextColor3 = optionText == tostring(selected) and Color3.fromRGB(209, 209, 212)
									or Color3.fromRGB(148, 149, 153),
								TextSize = 9,
								TextXAlignment = Enum.TextXAlignment.Left,
								Parent = list,
							})
							addPadding(optionButton, 9, 3, 0, 0)
							connect(self._window, optionButton.MouseEnter, function()
								tween(optionButton, 0.1, { BackgroundColor3 = THEME.FieldHover })
							end)
							connect(self._window, optionButton.MouseLeave, function()
								tween(optionButton, 0.1, { BackgroundColor3 = THEME.Field })
							end)
							connect(self._window, optionButton.MouseButton1Click, function()
								setSelected(option)
							end)
							table.insert(optionButtons, optionButton)
						end
					end
					list.CanvasSize = UDim2.fromOffset(0, visibleCount * 16)
				end

				setSelected = function(value, silent)
					selected = value
					selectedLabel.Text = tostring(value)
					populate(search.Text)
					if not silent then
						callback(dropdownConfig.Callback, value)
