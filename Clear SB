	addFeatureToggle(visualSection, "playerESP", "Highlight All Players White", "WHITE")
	visualSection:AddLabel({ Text = "Highlights update only when sharks spawn or the toggle changes." })

	addFeatureToggle(boatSection, "boatBoost", "Boat Speed", "BOOST")
	addFeatureToggle(boatSection, "autoRide", "Auto Ride", "SEAT")
	boatSection:AddSlider({
		Title = "Boat Speed Multiplier",
		Min = 1,
		Max = 8,
		Default = state.boatMultiplier,
		Round = true,
		Callback = function(value)
			state.boatMultiplier = value
			applyBoatBoost()
		end,
	})
	boatStatus = boatSection:AddLabel({ Text = "Boat: waiting" })

	local boatEntriesByLabel = {}
	boatDropdown = selectorSection:AddDropdown({
		Title = "All Boats",
		Options = { "Loading boat catalog..." },
		Default = "Loading boat catalog...",
		Open = true,
		Callback = function(label)
			local entry = boatEntriesByLabel[label]
			if not entry then
				return
			end
			state.requestedBoat = entry.display
			state.selectedBoat = entry.display
			if boatStatus then
				boatStatus:Set("Boat: requesting " .. entry.display)
			end
			if type(state.equipBoat) == "function" then
				local ok = pcall(state.equipBoat, entry.id)
				if not ok and boatStatus then
					boatStatus:Set("Boat: equip callback failed")
				end
			else
				boatStatus:Set("Boat: equip callback unavailable")
			end
			scheduleRide()
			task.delay(0.9, function()
				if not state.alive then
					return
				end
				local spawned = getOwnedBoat(entry.display)
				if spawned then
					boatStatus:Set("Boat: " .. spawned.Name .. " equipped")
				else
					boatStatus:Set(entry.owned and "Boat: waiting to spawn" or "Boat: server locked")
				end
			end)
		end,
	})
	selectorSection:AddLabel({ Text = "Every boat is listed. Locked boats are requested too, but the server decides ownership." })
	local keybindButton
	local waitingForMenuKey = false
	keybindButton = guiSection:AddButton({
		Title = "Menu Keybind: " .. state.menuKey.Name,
		Callback = function()
			waitingForMenuKey = true
			window:SetKeyCapture(true)
			keybindButton.Instance.Text = "Press any keyboard key..."
		end,
	})
	connect(UserInputService.InputBegan, function(input)
		if not waitingForMenuKey or input.UserInputType ~= Enum.UserInputType.Keyboard then
			return
		end
		if input.KeyCode == Enum.KeyCode.Unknown then
			return
		end
		waitingForMenuKey = false
		state.menuKey = input.KeyCode
		window:SetToggleKey(input.KeyCode)
		window:SetKeyCapture(false)
		keybindButton.Instance.Text = "Menu Keybind: " .. input.KeyCode.Name
	end)
	guiSection:AddLabel({ Text = "Press LeftAlt by default. Click the keybind button and press any key to replace it." })

	local function firstLuaCallback(signal)
		if type(getconnections) ~= "function" then
			return nil
		end
		for _, connection in ipairs(getconnections(signal)) do
			if type(connection.Function) == "function" then
				return connection.Function
			end
		end
		return nil
	end

	local function buildBoatCatalog()
		local catalog = {}
		local ownedNames = {}
		local inventoryManager = require(playerScripts:WaitForChild("Inventory"):WaitForChild("InventoryManager"))
		local storeModuleFolder = playerScripts:WaitForChild("Store"):WaitForChild("StoreModule")
		local equipModule = require(storeModuleFolder:WaitForChild("EquipModule"))
		local boatAssets = inventoryManager.getBoatAssets()
		for key, data in pairs(boatAssets) do
			if type(data) == "table" and data.isBoat then
				table.insert(catalog, {
					display = data.name or key,
					key = key,
					id = data.id,
					owned = data.owned == true,
					equipped = data.equipped == true,
				})
			end
		end
		state.equipBoat = function(id)
			return equipModule.equip("Boats", id)
		end

		if false then
		local boatSelection = player.PlayerGui:WaitForChild("BoatSelection", 20)
		local selectionFrame = boatSelection and boatSelection:FindFirstChild("Frame")
		local selectionRoot = selectionFrame and selectionFrame:FindFirstChild("BoatSelectionFrame")
		local playerBoats = selectionRoot and selectionRoot:FindFirstChild("PlayerBoatsSelection")
		local ownedContainer = playerBoats and playerBoats:FindFirstChild("BoatsContainer")
		if ownedContainer then
			for _, item in ipairs(ownedContainer:GetChildren()) do
				if item:IsA("Frame") and item.Visible then
					local label = item:FindFirstChild("BoatName")
					if label and label:IsA("TextLabel") then
						ownedNames[normalize(label.Text)] = true
					end
				end
			end
		end

		local store = player.PlayerGui:WaitForChild("Store", 20)
		local storeContainer = store and store:FindFirstChild("StoreContainer")
		local mainFrame = storeContainer and storeContainer:FindFirstChild("MainFrame")
		local itemsFrame = mainFrame and mainFrame:FindFirstChild("ItemsFrame")
		local details = mainFrame and mainFrame:FindFirstChild("DetailsFrame")
		local bottom = details and details:FindFirstChild("Bottom")
		local purchaseFrame = bottom and bottom:FindFirstChild("PurchaseFrame")
		local equipButton = purchaseFrame and purchaseFrame:FindFirstChild("EquipButton")
		local navBar = mainFrame and mainFrame:FindFirstChild("NavBar")
		local boatsButton = navBar and navBar:FindFirstChild("Boats")
		if boatsButton and type(firesignal) == "function" then
			pcall(firesignal, boatsButton.Activated)
			task.wait(0.6)
		end

		if equipButton and type(getupvalues) == "function" then
			local outer = firstLuaCallback(equipButton.Activated)
			local upvalues = outer and getupvalues(outer)
			if upvalues then
				for _, value in ipairs(upvalues) do
					if type(value) == "table" and type(value.equip) == "function" then
						state.equipBoat = value.equip
						break
					end
				end
			end
		end

		if itemsFrame and type(getupvalues) == "function" then
			for _, frame in ipairs(itemsFrame:GetChildren()) do
				if frame:IsA("Frame") and frame.Name ~= "Template" and frame.Name ~= "PremiumTemplate" then
					local button = frame:FindFirstChild("Contents")
					local callbackFn = button and firstLuaCallback(button.Activated)
					local upvalues = callbackFn and getupvalues(callbackFn)
					local key = upvalues and upvalues[2]
					local category = upvalues and upvalues[3]
					if type(key) == "string" and category == "Boats" then
						table.insert(catalog, {
							display = frame.Name,
							key = key,
							owned = ownedNames[normalize(frame.Name)] == true,
						})
					end
				end
			end
		end

		end

		table.sort(catalog, function(a, b)
			return a.display < b.display
		end)
		state.fullBoatCatalog = catalog
		state.catalogCount = #catalog
		local labels = {}
		table.clear(boatEntriesByLabel)
		for _, entry in ipairs(catalog) do
			local label = (entry.owned and "[Owned] " or "[Locked] ") .. entry.display
			boatEntriesByLabel[label] = entry
			table.insert(labels, label)
		end
		if #labels == 0 then
			labels = { "Boat catalog unavailable" }
		end
		boatDropdown:Refresh(labels, false)
		boatStatus:Set(string.format("Boat: %d total / search and select", #catalog))
	end
	state.refreshBoatCatalog = buildBoatCatalog

	local function pointerOverClear(position)
		local main = window.Main
		if main and main.Visible then
			local at = main.AbsolutePosition
			local size = main.AbsoluteSize
			if position.X >= at.X and position.X <= at.X + size.X
				and position.Y >= at.Y and position.Y <= at.Y + size.Y
			then
				return true
			end
		end
		local launcher = window.Gui and window.Gui:FindFirstChild("Launcher")
		if launcher and launcher.Visible then
			local at = launcher.AbsolutePosition
			local size = launcher.AbsoluteSize
			return position.X >= at.X and position.X <= at.X + size.X
				and position.Y >= at.Y and position.Y <= at.Y + size.Y
		end
		return false
	end

	connect(UserInputService.InputBegan, function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1 then
			return
		end
		if UserInputService:GetFocusedTextBox() or pointerOverClear(input.Position) then
			return
		end
		local tool = equippedWeapon()
		if not tool then
			return
		end
		fireDamageBurst(tool, input)
		if not state.holdToFire or state.holdingFire then
			return
		end
		state.holdingFire = true
		state.fireToken += 1
		local token = state.fireToken
		task.spawn(function()
			local interval = math.max(1 / math.clamp(state.fireRate, 1, 120), 1 / 120) + 0.001
			task.wait(interval)
			while state.alive and state.holdToFire and state.holdingFire and token == state.fireToken do
				local tool = equippedWeapon()
				if not tool then
					break
				end
				directFire(tool, input)
				task.wait(interval)
			end
		end)
	end)

	connect(UserInputService.InputEnded, function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			stopHoldFire()
		end
	end)

	local function getLine(shark)
		local line = state.lineFrames[shark]
		if line and line.Parent then
			return line
		end
		line = Instance.new("Frame")
		line.Name = "ClearRedSharkTracer"
		line.AnchorPoint = Vector2.new(0.5, 0.5)
		line.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
		line.BorderSizePixel = 0
		line.ZIndex = 2
		line.Visible = false
		line.Parent = lineGui
		local gradient = Instance.new("UIGradient")
		gradient.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(150, 0, 0)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 65, 65)),
		})
		gradient.Parent = line
		state.lineFrames[shark] = line
		return line
	end

	connect(RunService.RenderStepped, function()
		local camera = workspace.CurrentCamera
		if not camera then
			return
		end
		local viewport = camera.ViewportSize
		local origin = Vector2.new(viewport.X * 0.5, viewport.Y - 2)
		for shark, target in pairs(state.sharkTargets) do
			local line = getLine(shark)
			if state.sharkLines and shark.Parent and target and target.Parent then
				local point, onScreen = camera:WorldToViewportPoint(target.Position)
				if onScreen and point.Z > 0 then
					local endpoint = Vector2.new(point.X, point.Y)
					local delta = endpoint - origin
					line.Position = UDim2.fromOffset((origin.X + endpoint.X) * 0.5, (origin.Y + endpoint.Y) * 0.5)
					line.Size = UDim2.fromOffset(delta.Magnitude, 3)
					line.Rotation = math.deg(math.atan2(delta.Y, delta.X))
					line.Visible = true
				else
					line.Visible = false
				end
			else
				line.Visible = false
			end
		end
	end)

	local boatsFolder = workspace:FindFirstChild("Boats")
	if boatsFolder then
		connect(boatsFolder.ChildAdded, function()
			if state.autoRide then
				task.delay(0.5, scheduleRide)
			end
		end)
	end

	local accumulator = 0
	connect(RunService.Heartbeat, function(delta)
		accumulator += delta
		if accumulator < 0.2 then
			return
		end
		accumulator = 0
		applyWeaponStats()
		refreshAmmo(false)
		local boat = applyBoatBoost()
		local tool = anyWeapon()
		if statusControl then
			statusControl:Set(string.format(
				"Weapon: %s | %d CPS | %d bullets | speed %d",
				tool and tool.Name or "waiting",
				state.fireRate,
				state.bulletsPerShot,
				state.bulletSpeed
			))
		end
		if boatStatus and boat then
			boatStatus:Set(string.format("Boat: %s | x%d speed", boat.Name, state.boatMultiplier))
		end
	end)

	function state.destroy(restore)
		if not state.alive then
			return
		end
		state.alive = false
		stopHoldFire()
		state.rideToken += 1
		state.burstToken += 1
		if rayProjectileRender.RenderBulletArc == wrappedRenderBulletArc then
			rayProjectileRender.RenderBulletArc = state.originalRenderBulletArc
		end
		if commonWeapon.raycastFromCamera == wrappedRaycastFromCamera then
			commonWeapon.raycastFromCamera = state.originalRaycastFromCamera
		end
		if commonWeapon.raycastFromWeapon == wrappedRaycastFromWeapon then
			commonWeapon.raycastFromWeapon = state.originalRaycastFromWeapon
		end

		if restore ~= false then
			for stats, original in pairs(state.originals) do
				if stats then
					stats.MagSize = original.MagSize
					stats.FireRate = original.FireRate
					stats.ReloadTime = original.ReloadTime
					stats.Spread = original.Spread
					stats.Recoil = original.Recoil
					stats.Mode = original.Mode
					stats.BulletAmount = original.BulletAmount
					stats.ProjectileSpeed = original.ProjectileSpeed
					stats.BulletSpeed = original.BulletSpeed
					stats.Gravity = original.Gravity
				end
			end
			restoreBoatSpeed()
			pcall(bulletCount.resetWeapons)
			local tool = anyWeapon()
			if tool then
				pcall(bulletCount.ChangeWeapon, tool)
			end
		end

		for _, connection in ipairs(state.connections) do
			pcall(function()
				connection:Disconnect()
			end)
		end
		for _, highlight in pairs(state.highlights) do
			if highlight and highlight.Parent then
				highlight:Destroy()
			end
		end
		for _, highlight in pairs(state.playerHighlights) do
			if highlight and highlight.Parent then
				highlight:Destroy()
			end
		end
		for _, outline in pairs(state.outlines) do
			if outline and outline.Parent then
				outline:Destroy()
			end
		end
		if lineGui and lineGui.Parent then
			lineGui:Destroy()
		end
		if window then
			window:Destroy()
		end
		if env.__CodexSharkBoost == state then
			env.__CodexSharkBoost = nil
		end
	end

	local liveState = STATE
	if liveState and type(liveState.onCleanup) == "function" then
		liveState.onCleanup(function()
			state.destroy(true)
		end)
	end

	applyAll(true)
	window:SelectTab(tabs.Weapons)
	task.spawn(buildBoatCatalog)
	scheduleRide()
end

return Clear
