	local function getOwnedBoat(preferredName)
		local boats = workspace:FindFirstChild("Boats")
		if not boats then
			return nil
		end
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local preferred = preferredName and normalize(preferredName)
		local fallback
		for _, boat in ipairs(boats:GetChildren()) do
			local seats = boat:FindFirstChild("Seats")
			local vehicleSeat = seats and seats:FindFirstChild("VehicleSeat")
			if vehicleSeat then
				local isOwner = vehicleSeat:GetAttribute("NetworkOwnerName") == player.Name
				local isDriving = humanoid and vehicleSeat.Occupant == humanoid
				if isOwner or isDriving then
					fallback = fallback or boat
					if preferred and normalize(boat.Name) == preferred then
						return boat
					end
				end
			end
		end
		return fallback
	end

	local function restoreBoatSpeed()
		for valueObject, original in pairs(state.boatOriginals) do
			if valueObject and valueObject.Parent then
				pcall(function()
					valueObject.Value = original
				end)
			end
		end
	end

	local function applyBoatBoost()
		local boat = getOwnedBoat(state.selectedBoat)
		if not boat then
			return nil
		end
		local configuration = boat:FindFirstChild("Configuration")
		local engine = configuration and configuration:FindFirstChild("Engine")
		local maxSpeed = engine and engine:FindFirstChild("MaxSpeed")
		if maxSpeed and maxSpeed:IsA("ValueBase") then
			if state.boatOriginals[maxSpeed] == nil then
				state.boatOriginals[maxSpeed] = maxSpeed.Value
			end
			local original = state.boatOriginals[maxSpeed]
			maxSpeed.Value = state.boatBoost and original * state.boatMultiplier or original
		end
		return boat
	end

	local function tryRideBoat(boat)
		if not state.autoRide or not boat then
			return false
		end
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local root = character and character:FindFirstChild("HumanoidRootPart")
		local seats = boat:FindFirstChild("Seats")
		local vehicleSeat = seats and seats:FindFirstChild("VehicleSeat")
		if not humanoid or not root or not vehicleSeat then
			return false
		end
		if vehicleSeat.Occupant == humanoid then
			return true
		end
		root.CFrame = vehicleSeat.CFrame * CFrame.new(0, 3, 0)
		task.wait(0.1)
		vehicleSeat:Sit(humanoid)
		return true
	end

	local function scheduleRide()
		state.rideToken += 1
		local token = state.rideToken
		task.spawn(function()
			for _ = 1, 24 do
				if not state.alive or not state.autoRide or token ~= state.rideToken then
					return
				end
				if tryRideBoat(getOwnedBoat(state.selectedBoat)) then
					return
				end
				task.wait(0.5)
			end
		end)
	end

