	local launcherLastClick = -math.huge
	local headerLastClick = -math.huge
	local function pointInside(guiObject, position)
		local corner = guiObject.AbsolutePosition
		local size = guiObject.AbsoluteSize
		local function contains(x, y)
			return x >= corner.X and x <= corner.X + size.X
				and y >= corner.Y and y <= corner.Y + size.Y
		end
		if contains(position.X, position.Y) then
			return true
		end
		local inset = GuiService:GetGuiInset()
		return contains(position.X - inset.X, position.Y - inset.Y)
	end
	local function registerDoubleClick(useLauncher)
		local now = os.clock()
		local lastClick = useLauncher and launcherLastClick or headerLastClick
		if now - lastClick <= 0.55 then
			if useLauncher then
				launcherLastClick = -math.huge
			else
				headerLastClick = -math.huge
			end
			window:SetVisible(not window._visible)
		elseif useLauncher then
			launcherLastClick = now
		else
			headerLastClick = now
		end
	end
	connect(window, UserInputService.InputBegan, function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1
			and input.UserInputType ~= Enum.UserInputType.Touch
		then
			return
		end
		if launcher.Visible and pointInside(launcher, input.Position) then
			registerDoubleClick(true)
		elseif main.Visible and pointInside(expandButton, input.Position) then
			registerDoubleClick(false)
		end
	end)
	connect(window, searchButton.MouseButton1Click, function()
		searchBox.Visible = not searchBox.Visible
		if searchBox.Visible then
			searchBox:CaptureFocus()
		else
			searchBox.Text = ""
		end
	end)
	connect(window, searchBox:GetPropertyChangedSignal("Text"), function()
		local query = string.lower(searchBox.Text)
		for _, tab in ipairs(window._tabs) do
			tab._button.Visible = query == "" or string.find(string.lower(tab.Title), query, 1, true) ~= nil
		end
	end)
	connect(window, UserInputService.InputBegan, function(input)
		if not window._capturingKey and input.KeyCode == window._toggleKey then
			window:Toggle()
		end
	end)

	makeDraggable(window, header, main)
	return window
end

