	local function bindSharks(folder)
		for _, shark in ipairs(folder:GetChildren()) do
			ensureHighlight(shark)
		end
		connect(folder.ChildAdded, ensureHighlight)
		connect(folder.ChildRemoved, function(shark)
			state.sharkTargets[shark] = nil
			local line = state.lineFrames[shark]
			if line then
				line:Destroy()
				state.lineFrames[shark] = nil
			end
		end)
	end
