	local function normalize(value)
		return string.lower((tostring(value):gsub("[^%w]", "")))
	end

	local function equippedWeapon()
		local character = player.Character
		if not character then
			return nil
		end
		for _, child in ipairs(character:GetChildren()) do
			if child:IsA("Tool") and projectileStats[child.Name] then
				return child
			end
		end
		return nil
	end

	local function anyWeapon()
		local tool = equippedWeapon()
		if tool then
			return tool
		end
		local backpack = player:FindFirstChildOfClass("Backpack")
		if backpack then
			for _, child in ipairs(backpack:GetChildren()) do
				if child:IsA("Tool") and projectileStats[child.Name] then
					return child
				end
			end
		end
		return nil
	end

	local function rememberStats(stats)
		local original = state.originals[stats]
		if original then
			return original
		end
		original = {
			MagSize = stats.MagSize,
			FireRate = stats.FireRate,
			ReloadTime = stats.ReloadTime,
			Spread = stats.Spread,
			Recoil = stats.Recoil,
			Mode = stats.Mode,
			BulletAmount = stats.BulletAmount,
			ProjectileSpeed = stats.ProjectileSpeed,
			BulletSpeed = stats.BulletSpeed,
			Gravity = stats.Gravity,
		}
		state.originals[stats] = original
		return original
	end

	local function zeroLike(value)
		if typeof(value) == "Vector3" then
			return Vector3.zero
		elseif typeof(value) == "Vector2" then
			return Vector2.zero
		elseif typeof(value) == "number" then
			return 0
		end
		return value
	end

	local function applyWeaponStats()
		for _, stats in pairs(projectileStats) do
			if type(stats) == "table" then
				local original = rememberStats(stats)
				if original.MagSize ~= nil then
					stats.MagSize = state.unlimitedAmmo and math.huge or original.MagSize
				end
				if original.FireRate ~= nil then
					stats.FireRate = state.rapidFire and state.fireRate or original.FireRate
				end
				if original.ReloadTime ~= nil then
					stats.ReloadTime = state.noReload and 0 or original.ReloadTime
				end
				if original.Spread ~= nil then
					stats.Spread = state.noSpread and 0 or original.Spread
				end
				if original.Recoil ~= nil then
					stats.Recoil = state.noRecoil and zeroLike(original.Recoil) or original.Recoil
				end
				stats.Mode = original.Mode
				if original.Mode == 3 and original.BulletAmount ~= nil then
					stats.BulletAmount = state.multiBullet and state.bulletsPerShot or original.BulletAmount
				else
					stats.BulletAmount = original.BulletAmount
				end
				if original.ProjectileSpeed ~= nil then
					stats.ProjectileSpeed = original.ProjectileSpeed
				end
				if original.BulletSpeed ~= nil then
					stats.BulletSpeed = state.bulletSpeedEnabled and state.bulletSpeed or original.BulletSpeed
				end
				if original.Gravity ~= nil then
					stats.Gravity = original.Gravity
				end
			end
		end
	end

	local lastAmmoWeapon
	local function refreshAmmo(force)
		local tool = anyWeapon()
		if state.unlimitedAmmo then
			if tool and (force or tool ~= lastAmmoWeapon) then
				pcall(bulletCount.ChangeWeapon, tool)
				lastAmmoWeapon = tool
			end
		elseif force then
			pcall(bulletCount.resetWeapons)
			if tool then
				pcall(bulletCount.ChangeWeapon, tool)
			end
			lastAmmoWeapon = tool
		end
	end

	local function directFire(tool, inputObject)
		if not tool or tool.Parent ~= player.Character then
			return false
		end
		local stats = projectileStats[tool.Name]
		if not stats then
			return false
		end
		state.autoFireCalls += 1
		local original = state.originals[stats] or rememberStats(stats)
		local baseMode = original.Mode or stats.Mode
		if baseMode == 5 then
			pcall(projectileFire.fire, tool, inputObject, false)
		elseif baseMode == 101 then
			pcall(projectileFire.fireFlare, tool)
		elseif baseMode == 102 then
			pcall(projectileFire.fireBait, tool)
		elseif baseMode == 103 then
			pcall(projectileFire.fireTurtle, tool)
		else
			pcall(hitScan.Fire, tool, inputObject, false)
		end
		return true
	end
	state.directFireOnce = function()
		return directFire(equippedWeapon(), nil)
	end

	local function fireDamageBurst(tool, inputObject)
		if not state.damageBurst or not tool then
			return
		end
		local stats = projectileStats[tool.Name]
		local original = stats and rememberStats(stats)
		local nativeFireRate = original and tonumber(original.FireRate) or 1
		local nativeInterval = 1 / math.max(nativeFireRate, 0.01)
		state.burstToken += 1
		local token = state.burstToken
		task.spawn(function()
			for _ = 1, state.burstShots do
				if not state.alive or not state.damageBurst or token ~= state.burstToken then
					return
				end
				directFire(tool, inputObject)
				task.wait(nativeInterval)
			end
		end)
	end
	state.fireDamageBurst = function()
		return fireDamageBurst(equippedWeapon(), nil)
	end

	local function getSharkVisual(shark)
		local sharkMain = shark and shark:FindFirstChild("SharkMain")
		local mesh = sharkMain and sharkMain:FindFirstChild("Mesh")
		local visual = mesh and mesh:FindFirstChild("Shark")
		if visual and visual:IsA("BasePart") then
			return visual
		end
		return nil
	end

	local function nearestSharkToCursor()
		local sharks = workspace:FindFirstChild("Sharks")
		local camera = workspace.CurrentCamera
		if not sharks or not camera then
			return nil
		end
		local mousePosition = UserInputService:GetMouseLocation()
		local bestVisual
		local bestDistance = state.aimRadius
		for _, shark in ipairs(sharks:GetChildren()) do
			local visual = getSharkVisual(shark)
			if visual then
				-- GetMouseLocation is in screen space (including Roblox's top inset),
				-- so use WorldToScreenPoint here to prevent a vertical aim offset.
				local point, onScreen = camera:WorldToScreenPoint(visual.Position)
				if onScreen and point.Z > 0 then
					local distance = (Vector2.new(point.X, point.Y) - mousePosition).Magnitude
					if distance <= bestDistance then
						bestDistance = distance
						bestVisual = visual
					end
				end
			end
		end
		return bestVisual
	end

	state.originalRaycastFromCamera = commonWeapon.raycastFromCamera
