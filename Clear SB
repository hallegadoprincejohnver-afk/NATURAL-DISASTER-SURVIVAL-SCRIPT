	local function applyPlayerHighlight(targetPlayer)
		if targetPlayer == player then
			return
		end
		local character = targetPlayer.Character
		local highlight = state.playerHighlights[targetPlayer]
		if highlight and not highlight.Parent then
			highlight = nil
			state.playerHighlights[targetPlayer] = nil
		end
		if not character then
			if highlight then
				highlight.Enabled = false
			end
			return
		end
		if not highlight then
			highlight = Instance.new("Highlight")
			highlight.Name = "ClearWhitePlayerHighlight"
			highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
			highlight.FillColor = Color3.fromRGB(255, 255, 255)
			highlight.FillTransparency = 0.28
			highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
			highlight.OutlineTransparency = 0
			highlight.Parent = character
			state.playerHighlights[targetPlayer] = highlight
		end
		highlight.Adornee = character
		highlight.Enabled = state.playerESP
	end

