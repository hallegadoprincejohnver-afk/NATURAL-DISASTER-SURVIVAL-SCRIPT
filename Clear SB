	local wrappedRaycastFromCamera = function(...)
		if state.alive and state.sharkAccuracy and equippedWeapon() then
			local target = nearestSharkToCursor()
			if target then
				return target, target.Position, Vector3.yAxis
			end
		end
		return state.originalRaycastFromCamera(...)
	end
	local wrappedRaycastFromWeapon = function(tool, aimPosition)
		if state.alive and state.sharkAccuracy and tool and tool.Parent == player.Character then
			local target = nearestSharkToCursor()
			if target then
				return target, target.Position
			end
		end
		return state.originalRaycastFromWeapon(tool, aimPosition)
	end
	commonWeapon.raycastFromCamera = wrappedRaycastFromCamera
	commonWeapon.raycastFromWeapon = wrappedRaycastFromWeapon

	local function applyOneSharkVisual(shark)
		local visual = getSharkVisual(shark)
		if not visual then
			return false
		end

		local oldHighlight = shark:FindFirstChild("CodexRedSharkHighlight")
		if oldHighlight then
			oldHighlight:Destroy()
		end
		local highlight = visual:FindFirstChild("ClearRedSharkHighlight")
		if not highlight then
			highlight = Instance.new("Highlight")
			highlight.Name = "ClearRedSharkHighlight"
			highlight.Parent = visual
		end
		highlight.Adornee = visual
		highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		highlight.FillColor = Color3.fromRGB(255, 0, 0)
		highlight.FillTransparency = 0
		highlight.OutlineColor = Color3.fromRGB(255, 70, 70)
		highlight.OutlineTransparency = 0
		highlight.Enabled = state.sharkESP

		local outline = visual:FindFirstChild("ClearRedSharkOutline")
		if not outline then
			outline = Instance.new("SelectionBox")
			outline.Name = "ClearRedSharkOutline"
			outline.Parent = visual
		end
		outline.Adornee = visual
		outline.Color3 = Color3.fromRGB(255, 0, 0)
		outline.SurfaceColor3 = Color3.fromRGB(255, 0, 0)
		outline.SurfaceTransparency = 0.72
		outline.LineThickness = 0.08
		outline.Visible = state.sharkESP

		state.sharkTargets[shark] = visual
		state.highlights[shark] = highlight
		state.outlines[shark] = outline
		return true
	end

	local function ensureHighlight(shark)
		if not shark:IsA("Model") then
			return
		end
		if applyOneSharkVisual(shark) then
			return
		end
		connect(shark.DescendantAdded, function(descendant)
			if descendant.Name == "Shark" or descendant.Name == "Mesh" or descendant.Name == "SharkMain" then
				task.defer(applyOneSharkVisual, shark)
			end
		end)
		task.spawn(function()
			while state.alive and shark.Parent and not state.sharkTargets[shark] do
				if applyOneSharkVisual(shark) then
					return
				end
				task.wait(0.2)
			end
		end)
	end

